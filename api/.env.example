DATABASE_URL=""
PORT=3001
BIRDEYE_API_KEY=""
JUPITER_API_URL=https://jup-proxy-production-eff9.up.railway.app
PRICE_CACHE_TTL_MS=30000
JUPITER_TIMEOUT_MS=3000
LP_EARNINGS_INTERVAL_MS=60000
LP_EARNINGS_LIMIT=1000
LP_EARNINGS_MAX_EVENTS=1000
LP_EARNINGS_PROGRESS_EVERY=1000

# Optional private Railway Bucket for token logos (API and worker).
TOKEN_LOGO_CACHE_ENABLED=false
TOKEN_LOGO_API_ORIGIN=https://api.indexer.omnipair.fi
TOKEN_LOGO_S3_ENDPOINT=
TOKEN_LOGO_S3_BUCKET=
TOKEN_LOGO_S3_REGION=auto
TOKEN_LOGO_S3_ACCESS_KEY_ID=
TOKEN_LOGO_S3_SECRET_ACCESS_KEY=
TOKEN_LOGO_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Opt-in LP icon/metadata generation. Apply migration 018 and run the separate
# LP assets worker before enabling the API. No uploads happen in API handlers.
LP_ASSETS_ENABLED=false
LP_ASSETS_MAINNET_RPC_URL=
LP_ASSETS_PINATA_JWT=
# HTTPS origin only; <=51 characters keeps returned IPFS URIs <=128 bytes.
LP_ASSETS_GATEWAY_ORIGIN=https://gateway.pinata.cloud
LP_ASSETS_WORKER_CONCURRENCY=2
# Tests only: use an isolated local PostgreSQL database, never production.
LP_ASSETS_TEST_DATABASE_URL=
